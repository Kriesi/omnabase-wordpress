<?xml version="1.0"?>
<!--
  The integration layer: tests inside the wp-env tests environment (port 8889), against a real WordPress with WooCommerce, EDD and
  bbPress, through WordPress's own test library and yoast/phpunit-polyfills. Run by `composer test:integration`
  (bin/test-integration.sh), never directly on the Mac. Round zero has no integration test yet; round one adds the first.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/Integration/bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
  <testsuites>
    <testsuite name="integration">
      <directory suffix="Test.php">./tests/Integration</directory>
    </testsuite>
  </testsuites>
</phpunit>
