<?xml version="1.0"?>
<!--
  The integration layer: tests inside the wp-env tests environment (port 8889), against a real WordPress, through WordPress's own test
  library and yoast/phpunit-polyfills. Run by `composer test:integration` (bin/test-integration.sh), never directly on the Mac.

  Two runs (M13 round two): the plain WordPress (every test outside the group "shops"), and, with OMNABASE_TEST_SHOPS=1, WordPress with
  WooCommerce, EDD and License Manager for WooCommerce loaded (the group "shops": the customer-data and outbox tests). The shops' admin code
  phones home and prints notices of its own, so the round-one tests keep a WordPress without them.

  A third run (M13 round three): with OMNABASE_TEST_FORUM=1, WordPress with bbPress loaded (the group "forum": topics, replies and
  OmnaBase's answers posted back). The plain run leaves that group out too.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/Integration/bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
  <testsuites>
    <testsuite name="integration">
      <directory suffix="Test.php">./tests/Integration</directory>
    </testsuite>
  </testsuites>
  <groups>
    <exclude>
      <group>shops</group>
      <group>forum</group>
    </exclude>
  </groups>
</phpunit>
