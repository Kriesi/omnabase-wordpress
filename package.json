{
  "name": "omnabase-wordpress",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "OmnaBase for WordPress: the local WordPress (wp-env) and the browser flows (Playwright). The plugin itself is PHP; see composer.json.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "seed": "bin/seed.sh",
    "e2e": "playwright test",
    "dist": "bin/build-dist.sh",
    "pot": "bin/make-pot.sh",
    "env:fresh": "wp-env start --config=.wp-env.fresh.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@wordpress/env": "11.17.0",
    "typescript": "5.9.3"
  }
}
