{
    "name": "kriesi/omnabase-wordpress",
    "description": "OmnaBase for WordPress: connects a WordPress site to the OmnaBase support inbox.",
    "license": "GPL-2.0-or-later",
    "type": "wordpress-plugin",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "mockery/mockery": "^1.6",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "OmnaBase\\WordPress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OmnaBase\\WordPress\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit,structure",
        "test:unit": "phpunit --testsuite unit",
        "test:structure": "phpunit --testsuite structure",
        "test:integration": "bin/test-integration.sh",
        "i18n:pot": "bin/make-pot.sh",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    }
}
